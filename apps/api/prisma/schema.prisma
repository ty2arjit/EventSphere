// Full Profile Domain schema (Ch.19) — Phase 0. UserProfile and UserPreferences
// are Owned Entities (not Value Objects), each backed by its own 1:1 table
// keyed by userId rather than a synthetic id — nothing references them
// independently of their owning User (Constitution Article 37).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime queries. Use Neon's POOLED connection string — pooling is what
  // makes many short-lived serverless/container connections viable.
  url = env("DATABASE_URL")

  // Migrations only. Use Neon's DIRECT connection string.
  //
  // Migrations issue DDL and rely on session-level state (advisory locks,
  // prepared statements) that PgBouncer's transaction pooling does not
  // preserve, so running them through the pooled URL is unreliable.
  //
  // REQUIRED — not optional. Prisma resolves this at schema-load time and
  // fails with P1012 ("Environment variable not found") if it is missing,
  // even for commands that never open a connection. It must be set in every
  // environment, including local development.
  //
  // For Neon, the direct host is the pooled host with `-pooler` removed.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  name       String
  status     String    @default("registered")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  profile          UserProfile?
  preferences      UserPreferences?
  credential       UserCredential?
  ownedCommunities Community[]       @relation("CommunityOwner")
  memberships      CommunityMember[]

  @@map("users")
}

model UserProfile {
  userId         String  @id
  avatarUrl      String?
  bio            String?
  headline       String?
  institution    String?
  department     String?
  graduationYear Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserPreferences {
  userId        String  @id
  language      String  @default("en")
  timezone      String  @default("UTC")
  theme         String  @default("system")
  notifyByEmail Boolean @default(true)
  notifyInApp   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Authentication Domain (Ch.20). One credential record per User (Ch.20
// invariant); credential.id == user.id — the same identity, different
// bounded contexts. Passwords are never plaintext; the value stored is
// argon2id-hashed (see HashedPassword VO). OAuth-only accounts have
// hashedPassword = null.
model UserCredential {
  id              String    @id                    // matches User.id
  email           String    @unique                // Auth's own copy, kept in sync via EmailVerified/UserEmailChanged events
  hashedPassword  String?                          // "argon2id$..." serialized; null for OAuth-only
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User                     @relation(fields: [id], references: [id], onDelete: Cascade)
  providers  AuthenticationProvider[]
  sessions   AuthenticationSession[]
  tokens     VerificationToken[]

  @@map("user_credentials")
}

// Provider linkage — password (always for locally-registered users) or an
// OAuth provider (future — FR-001 for Google). Multiple providers per
// credential allowed; all resolve to the same canonical User (Ch.20).
model AuthenticationProvider {
  id                String   @id @default(uuid())
  userCredentialId  String
  provider          String                          // 'password' | 'google' | ...
  providerAccountId String                          // password: email; google: sub
  linkedAt          DateTime @default(now())

  credential UserCredential @relation(fields: [userCredentialId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userCredentialId])
  @@map("authentication_providers")
}

// One row per active login. refreshTokenHash is SHA-256 of the raw refresh
// token — the raw token is never persisted. Rotation writes a new row and
// marks the old one revoked (revokedAt set).
model AuthenticationSession {
  id                String    @id @default(uuid())
  userCredentialId  String
  refreshTokenHash  String    @unique
  deviceLabel       String?
  ipAddress         String?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  credential UserCredential @relation(fields: [userCredentialId], references: [id], onDelete: Cascade)

  @@index([userCredentialId])
  @@map("authentication_sessions")
}

// Single-use tokens for email verification and password reset. tokenHash
// is SHA-256 of the raw token; the raw token is embedded in the email URL
// once and never stored.
model VerificationToken {
  id                String    @id @default(uuid())
  userCredentialId  String
  purpose           String                          // 'email_verification' | 'password_reset'
  tokenHash         String    @unique
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  consumedAt        DateTime?

  credential UserCredential @relation(fields: [userCredentialId], references: [id], onDelete: Cascade)

  @@index([userCredentialId, purpose])
  @@map("verification_tokens")
}

// Community Domain (Ch.18). The Community aggregate root owns members,
// positions, invitations, and settings. Every community has exactly one
// owner (ownerId). Leadership history is preserved — assignments are
// never deleted, only soft-closed (removedAt set).

model Community {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner       User                  @relation("CommunityOwner", fields: [ownerId], references: [id])
  members     CommunityMember[]
  positions   CommunityPosition[]
  invitations CommunityInvitation[]
  settings    CommunitySettings?
  events      Event[]

  @@map("communities")
}

model CommunityMember {
  id          String    @id @default(uuid())
  communityId String
  userId      String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
  assignments PositionAssignment[]

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

model CommunityPosition {
  id                    String    @id @default(uuid())
  communityId           String
  name                  String
  description           String?
  allowsMultipleHolders Boolean   @default(false)
  createdAt             DateTime  @default(now())

  community   Community            @relation(fields: [communityId], references: [id], onDelete: Cascade)
  assignments PositionAssignment[]

  @@unique([communityId, name])
  @@map("community_positions")
}

model PositionAssignment {
  id         String    @id @default(uuid())
  positionId String
  memberId   String
  assignedAt DateTime  @default(now())
  removedAt  DateTime?

  position CommunityPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  member   CommunityMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@index([memberId])
  @@map("position_assignments")
}

model CommunityInvitation {
  id              String    @id @default(uuid())
  communityId     String
  invitedEmail    String
  invitedByUserId String
  status          String    @default("pending")
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  respondedAt     DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@map("community_invitations")
}

model CommunitySettings {
  communityId            String  @id
  isPublic               Boolean @default(true)
  allowMemberInvitations Boolean @default(false)
  invitationExpiryDays   Int     @default(7)
  defaultMemberRole      String?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_settings")
}

// Authorization Domain. PermissionPolicy is a singleton aggregate —
// permissions and grants are child entities. "Deny is default":
// access is only granted when an active PermissionGrant matches.
// Permissions are never assigned directly to Users — they flow
// through ResponsibilityReferences (CommunityPosition, CommitteeRole,
// PlatformAdmin).

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  grants PermissionGrant[]

  @@map("permissions")
}

model PermissionGrant {
  id                    String    @id @default(uuid())
  permissionId          String
  contextLevel          String                          // 'Platform' | 'Community' | 'Event'
  contextId             String?
  responsibilityType    String                          // 'CommunityPosition' | 'CommitteeRole' | 'PlatformAdmin'
  responsibilityId      String
  grantedAt             DateTime  @default(now())
  revokedAt             DateTime?

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId])
  @@index([responsibilityType, responsibilityId])
  @@map("permission_grants")
}

// Event Management Domain (Ch.22-25). Event is the aggregate root;
// Session is an owned entity within the Event aggregate.

model Event {
  id           String    @id @default(uuid())
  communityId  String
  name         String
  slug         String    @unique
  description  String?
  bannerUrl    String?
  category     String?
  tags         String[]  @default([])
  mode         String    @default("Offline")
  visibility   String    @default("Public")
  venueLocation String?
  address      String?
  city         String?
  onlineUrl    String?
  capacityMin  Int?
  capacityMax  Int?
  startDate    DateTime?
  endDate      DateTime?
  state        String    @default("Draft")
  requireApproval       Boolean @default(false)
  allowWaitlist         Boolean @default(true)
  showAttendeeList      Boolean @default(true)
  allowGuestRegistration Boolean @default(false)
  // Pricing — an event is free unless isPaid is set. priceAmount is stored in
  // the currency's minor unit (paise for INR) as an integer: money is never a
  // float. Enforced at publish time (see Event.publish): a paid event must
  // carry a positive amount.
  isPaid        Boolean  @default(false)
  priceAmount   Int?
  priceCurrency String   @default("INR")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  community Community @relation(fields: [communityId], references: [id])
  sessions  EventSession[]

  @@index([communityId])
  @@map("events")
}

model EventSession {
  id          String    @id @default(uuid())
  eventId     String
  title       String
  description String?
  speaker     String?
  room        String?
  startAt     DateTime?
  endAt       DateTime?
  state       String    @default("Draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_sessions")
}

// ── Committee Domain ──

model EventCommittee {
  id          String    @id @default(uuid())
  eventId     String    @unique
  communityId String
  name        String
  state       String    @default("Planning")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roles       CommitteeRole[]
  assignments RoleAssignment[]

  @@map("event_committees")
}

model CommitteeRole {
  id              String    @id @default(uuid())
  committeeId     String
  name            String
  description     String?
  reportsToRoleId String?
  createdAt       DateTime  @default(now())

  committee   EventCommittee  @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  reportsTo   CommitteeRole?  @relation("RoleHierarchy", fields: [reportsToRoleId], references: [id])
  subordinates CommitteeRole[] @relation("RoleHierarchy")
  assignments RoleAssignment[]

  @@unique([committeeId, name])
  @@index([committeeId])
  @@map("committee_roles")
}

model RoleAssignment {
  id          String    @id @default(uuid())
  committeeId String
  roleId      String
  userId      String
  status      String    @default("Active")
  assignedAt  DateTime  @default(now())
  removedAt   DateTime?

  committee EventCommittee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  role      CommitteeRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([committeeId])
  @@index([roleId])
  @@map("role_assignments")
}

// ── Participation Management ──

model Registration {
  id               String    @id @default(uuid())
  eventId          String    @unique
  approvalStrategy String    @default("Automatic")
  windowOpensAt    DateTime?
  windowClosesAt   DateTime?
  maxParticipants  Int?
  allowWaitlist    Boolean   @default(false)
  isOpen           Boolean   @default(false)
  questions        Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enrollments Enrollment[]

  @@map("registrations")
}

model Enrollment {
  id             String    @id @default(uuid())
  registrationId String
  eventId        String
  userId         String
  status         String    @default("Pending")
  responses      Json      @default("[]")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([registrationId])
  @@index([eventId])
  @@index([userId])
  @@map("enrollments")
}

model AttendanceRecord {
  id           String    @id @default(uuid())
  enrollmentId String
  eventId      String
  sessionId    String
  userId       String
  status       String    @default("Present")
  checkInAt    DateTime?
  checkOutAt   DateTime?
  verifiedBy   String?
  createdAt    DateTime  @default(now())

  @@unique([sessionId, userId])
  @@index([eventId])
  @@index([enrollmentId])
  @@map("attendance_records")
}

model CertificateRecord {
  id               String    @id @default(uuid())
  enrollmentId     String
  eventId          String
  userId           String
  status           String    @default("Pending")
  templateId       String?
  verificationCode String    @unique
  issuedAt         DateTime?
  revokedAt        DateTime?
  revokedReason    String?
  createdAt        DateTime  @default(now())

  @@unique([enrollmentId])
  @@index([eventId])
  @@index([userId])
  @@index([verificationCode])
  @@map("certificates")
}

// ── Payment Domain ──

model Payment {
  id                String    @id @default(uuid())
  eventId           String
  userId            String
  // The enrollment this payment unlocks. Nullable only for the brief window
  // between order creation and the enrollment being linked; in practice the
  // enrollment always exists first (it is created in PendingPayment state).
  enrollmentId      String?
  // Minor units (paise for INR) — integer, never a float.
  amount            Int
  currency          String    @default("INR")
  // Created → Paid | Failed. Refunded is a post-Paid terminal state.
  status            String    @default("Created")
  provider          String    @default("razorpay")
  // Razorpay's order id (order_XXX). Unique so a duplicate create is a no-op.
  providerOrderId   String    @unique
  // Razorpay's payment id (pay_XXX), known only once the user actually pays.
  // Unique so the verify endpoint and the webhook can't double-confirm.
  providerPaymentId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("payments")
}

// ── Volunteer Domain ──

model OperationalTask {
  id              String    @id @default(uuid())
  eventId         String
  committeeRoleId String?
  title           String
  description     String?
  status          String    @default("Todo")
  priority        String    @default("Medium")
  dueDate         DateTime?
  assignments     Json      @default("[]")
  dependsOn       Json      @default("[]")
  checklistItems  Json      @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([eventId])
  @@index([status])
  @@map("operational_tasks")
}

// ── Announcement Domain ──

model Announcement {
  id          String    @id @default(uuid())
  communityId String?
  eventId     String?
  authorId    String
  title       String
  body        String
  priority    String    @default("Normal")
  channels    Json      @default("[]")
  publishedAt DateTime?
  expiresAt   DateTime?
  isDraft     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([communityId])
  @@index([eventId])
  @@index([authorId])
  @@map("announcements")
}

// ── Analytics Domain ──

model MetricRecord {
  id         String   @id @default(uuid())
  type       String
  entityId   String
  entityType String
  value      Float
  metadata   Json     @default("{}")
  recordedAt DateTime @default(now())

  @@index([entityId])
  @@index([type])
  @@index([entityId, type])
  @@map("metric_records")
}
