# Copy this file to .env and fill in real values.
# Never commit .env — it is gitignored. This template contains no secrets.
#
# Full deployment reference: docs/DEPLOYMENT_CHECKLIST.md

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string — POOLED. Used for runtime queries.
# From the Neon dashboard: Project > Connection Details > "Pooled connection".
# Format: postgresql://<user>:<password>@<host>-pooler.<region>.neon.tech/<db>?sslmode=require
DATABASE_URL=

# Neon PostgreSQL connection string — DIRECT. Used by Prisma migrations only.
#
# REQUIRED IN EVERY ENVIRONMENT, including local development. Prisma resolves
# this when loading the schema and fails with P1012 if it is missing — even for
# commands that never open a connection. It does NOT fall back to DATABASE_URL.
#
# Migrations issue DDL and depend on session state that PgBouncer's transaction
# pooling does not preserve, so they must not run through the pooled URL.
#
# For Neon this is the same string as DATABASE_URL with `-pooler` removed from
# the host.
DIRECT_DATABASE_URL=

# Browser origins permitted to call this API (CORS allow-list).
#
# Comma-separated. No trailing slashes — origins are compared exactly, so
# "https://example.com/" will NOT match a request from "https://example.com".
# Include the scheme.
#
# Defaults to http://localhost:3000 when unset, which is correct for local
# development but WRONG in production: the deployed frontend's requests would
# be rejected, surfacing as an opaque browser CORS error rather than an obvious
# configuration problem.
#
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
# Multiple:   https://your-app.vercel.app,https://staging-your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Port to listen on. Defaults to 4000.
# On Railway (and most PaaS platforms) this is injected automatically — do not
# set it manually there.
PORT=4000

# Runtime environment. Set to "production" when deployed.
# Controls log verbosity: "info" in production, "debug" otherwise.
# Node tooling sets this automatically in many contexts; set it explicitly on
# the deployment platform.
NODE_ENV=development

# ---------------------------------------------------------------------------
# AUTHENTICATION (Phase 0)
# ---------------------------------------------------------------------------

# HMAC secret used to sign JWT access tokens. Must be at least 32 random bytes
# (base64 or hex encoded). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# REQUIRED in every environment. The server refuses to start without it —
# missing this is a configuration bug, not a runtime warning.
#
# NEVER commit the real value. Rotate on suspected compromise; rotation
# invalidates all outstanding access tokens (users are pushed back through
# /refresh, which is fine — refresh tokens are stored separately).
JWT_ACCESS_SECRET=

# Public base URL of the frontend, used to construct verification and password-
# reset links sent by email. Include scheme, no trailing slash.
# Local:      http://localhost:3000
# Production: https://event-sphere-web.vercel.app
WEB_BASE_URL=http://localhost:3000

# Cookie behaviour. In production, Secure must be true (cookies won't be sent
# over plain HTTP) and SameSite should be "lax" for typical cross-origin flows.
# Locally over http://localhost these defaults still work because browsers
# treat localhost as secure.
COOKIE_SECURE=false
COOKIE_DOMAIN=
