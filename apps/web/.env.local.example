# Copy this file to .env.local and adjust if needed.
# .env.local is gitignored; this example file is committed.

# Base URL of the EventSphere API (apps/api).
# NEXT_PUBLIC_ prefix is required: this value is read in the browser, since the
# registration form calls the API directly from the client (see
# docs/plans/01-walking-skeleton-frontend.md Section 2).
# Contains no secrets — it is a public endpoint address.
NEXT_PUBLIC_API_URL=http://localhost:4000
