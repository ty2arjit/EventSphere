# Copy this file to .env.local and adjust if needed.
# .env.local is gitignored; this example file is committed and holds no secrets.
#
# Full deployment reference: docs/DEPLOYMENT_CHECKLIST.md

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Base URL of the EventSphere API (apps/api). No trailing slash.
#
# The NEXT_PUBLIC_ prefix is required: the registration form calls the API
# directly from the browser rather than proxying through the Next.js server
# (see docs/plans/01-walking-skeleton-frontend.md §2). The value is a public
# endpoint address and contains no secrets.
#
# IMPORTANT: Next.js inlines NEXT_PUBLIC_ variables at BUILD time, not runtime.
# Changing this on the hosting platform requires a REBUILD — restarting the app
# will not pick up a new value.
#
# Local:      http://localhost:4000
# Production: https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:4000
